{
  "name": "@phryneas/schedule-codemod",
  "version": "0.0.1",
  "description": "TypeScript codemod for @phryneas/schedule",
  "license": "MIT",
  "author": "Lenz Weber-Tronic",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": { "schedule-codemod": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "test": "npm run test:types && node --test test/*.test.ts",
    "test:types": "tsc --project tsconfig.json --noEmit",
    "prebuild": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/core": "^7.28.0",
    "recast": "^0.23.11",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "expect-type": "^1.4.0",
    "graphql": "16.14.2"
  }
}
