diff --git a/resources/remove-type-only-fields.js b/resources/remove-type-only-fields.js
new file mode 100644
index 0000000000000000000000000000000000000000..d952707654f458ffee2645e1f0704c12f5645824
--- /dev/null
+++ b/resources/remove-type-only-fields.js
@@ -0,0 +1,20 @@
+'use strict';
+
+// Preserve the field-erasure behavior used by the original v16 build.
+module.exports = function removeTypeOnlyFields() {
+  return {
+    visitor: {
+      Class(path) {
+        for (const field of path.get('body.body')) {
+          if (
+            field.isClassProperty() &&
+            field.node.typeAnnotation &&
+            !field.node.value
+          ) {
+            field.remove();
+          }
+        }
+      },
+    },
+  };
+};
